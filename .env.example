# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/ucpready

# Redis
REDIS_URL=redis://redis:6379

# Internal URLs (for Docker network)
MCP_URL=http://mcp-server:8080
API_INTERNAL_URL=http://api:3000

# Admin
ADMIN_JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32

# Platform Keys (Ed25519)
PLATFORM_PRIVATE_KEY_FILE=/run/secrets/platform_private_key
PLATFORM_PUBLIC_KEY_FILE=/run/secrets/platform_public_key

# Node Environment
NODE_ENV=production

# Ports (for development)
API_PORT=3000
MCP_PORT=8080
ADMIN_PORT=5173

# CORS (for development)
CORS_ORIGIN=http://localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
