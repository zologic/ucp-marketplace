# UCPReady AI Commerce Directory - Environment Configuration
# Generated by setup.sh or configure manually
# Copy to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string for all services
DATABASE_URL=postgresql://postgres:your_password_here@postgres:5432/ucpready

# Postgres password (used by docker-compose for postgres service)
POSTGRES_PASSWORD=your_password_here

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379

# =============================================================================
# Internal Service URLs (Docker Network)
# =============================================================================
MCP_URL=http://mcp-server:8080
API_INTERNAL_URL=http://api:3000

# =============================================================================
# Domain Configuration
# =============================================================================
# Primary domain for your marketplace (no http://, no trailing slash)
PRIMARY_DOMAIN=search.example.com

# CORS origin for API requests (include https://)
CORS_ORIGIN=https://search.example.com

# =============================================================================
# Webhook Configuration
# =============================================================================
# Marketplace webhook URL that merchants will send order notifications to
# This is registered with each merchant's UCP plugin
MARKETPLACE_WEBHOOK_URL=https://search.example.com/api/webhooks/order-completed

# Platform identifier for webhook registration (alphanumeric, underscores allowed)
PLATFORM_ID=ucp_marketplace

# =============================================================================
# Admin Configuration
# =============================================================================
# Admin JWT secret for authentication (generate with: openssl rand -base64 32)
ADMIN_JWT_SECRET=your_jwt_secret_here_min_32_chars

# Admin email for Let's Encrypt SSL and admin account
ADMIN_EMAIL=admin@example.com

# =============================================================================
# Platform Cryptographic Keys (Ed25519)
# =============================================================================
# Paths to Ed25519 key files for webhook signatures
# Generate with:
#   openssl genpkey -algorithm ed25519 -out secrets/platform_private_key.pem
#   openssl pkey -in secrets/platform_private_key.pem -pubout -out secrets/platform_public_key.pem
PLATFORM_PRIVATE_KEY_FILE=/run/secrets/platform_private_key
PLATFORM_PUBLIC_KEY_FILE=/secrets/platform_public_key.pem

# =============================================================================
# Email Notifications (Optional - Leave empty to disable)
# =============================================================================
# SMTP configuration for sending emails (invoices, alerts, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@example.com

# Admin email for receiving system alerts
ADMIN_ALERT_EMAIL=admin@example.com

# =============================================================================
# Stripe Configuration (Optional - Leave empty to skip)
# =============================================================================
# Stripe secret key (sk_live_... for production, sk_test_... for testing)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Revenue Configuration
# =============================================================================
# Default revenue split: percentage that goes to tenant (0-100)
# Platform gets the remainder (100 - this value)
# Example: 80 means tenant gets 80%, platform gets 20%
DEFAULT_TENANT_REVENUE_PERCENT=80

# =============================================================================
# Node Environment
# =============================================================================
NODE_ENV=production

# =============================================================================
# Service Ports (for development, not needed in production Docker setup)
# =============================================================================
API_PORT=3000
MCP_PORT=8080
ADMIN_PORT=5173

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# Rate limit window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# SEO Configuration
# =============================================================================
# Minimum products required for category to appear in sitemap
MIN_PRODUCTS_PER_CATEGORY=5

# Minimum products required for brand to appear in sitemap
MIN_PRODUCTS_PER_BRAND=3
